# Copy this file to .env, fill in real values, then run: chmod 600 .env
# Load it with:
#   set -a
#   source .env
#   set +a
#
# Never commit real Telegram credentials.

AGENT_PAGER_TELEGRAM_BOT_TOKEN=replace-with-botfather-token
AGENT_PAGER_TELEGRAM_CHAT_ID=replace-with-chat-id
AGENT_PAGER_DEFAULT_HOST=desktop
